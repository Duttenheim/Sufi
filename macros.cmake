# SUFI_TARGET is the target sufi_files and sufi_add_dependencies apply to.
# SUFI_DIR is the current folder. SUFI_DIR_STACK holds the folders pushed
# before it. "." means the directory of the calling CMakeLists.

# sufi_target(<name> SUFI_EXECUTABLE|SUFI_LIBRARY)
macro(sufi_target name type)
    if(${ARGC} LESS 2)
        message(FATAL_ERROR "sufi_target: expected sufi_target(<name> SUFI_EXECUTABLE|SUFI_LIBRARY)")
    endif()

    set(_sufi_type "${type}")
    string(TOUPPER "${_sufi_type}" _sufi_type)
    if(_sufi_type STREQUAL "SUFI_EXECUTABLE")
        add_executable(${name})
    elseif(_sufi_type STREQUAL "SUFI_LIBRARY")
        add_library(${name})
    else()
        message(FATAL_ERROR "sufi_target: unknown type '${type}'. Expected SUFI_EXECUTABLE or SUFI_LIBRARY.")
    endif()

    set(SUFI_TARGET "${name}")
    # Dependents inherit this folder only. sufi_dir folders stay off the include path.
    set_target_properties(${name} PROPERTIES SUFI_TARGET_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    unset(_sufi_type)
endmacro()

macro(sufi_dir)
    if(NOT DEFINED SUFI_DIR OR "${SUFI_DIR}" STREQUAL "")
        set(SUFI_DIR ".")
    endif()
    if(NOT DEFINED SUFI_DIR_STACK)
        set(SUFI_DIR_STACK)
    endif()

    # No argument pops back to the previous folder.
    if(${ARGC} EQUAL 0)
        list(LENGTH SUFI_DIR_STACK _sufi_len)
        if(_sufi_len EQUAL 0)
            message(FATAL_ERROR "sufi_dir: directory stack is empty")
        endif()
        math(EXPR _sufi_last "${_sufi_len} - 1")
        list(GET SUFI_DIR_STACK ${_sufi_last} SUFI_DIR)
        list(REMOVE_AT SUFI_DIR_STACK ${_sufi_last})
        unset(_sufi_len)
        unset(_sufi_last)
    else()
        list(APPEND SUFI_DIR_STACK "${SUFI_DIR}")
        if("${SUFI_DIR}" STREQUAL ".")
            set(SUFI_DIR "${ARGV0}")
        else()
            set(SUFI_DIR "${SUFI_DIR}/${ARGV0}")
        endif()
    endif()
endmacro()

# Add files to SUFI_TARGET. Each path is relative to SUFI_DIR.
# A trailing comma is ignored so sufi_files(file1.h, file1.cc) works.
macro(sufi_files)
    if(NOT DEFINED SUFI_TARGET OR "${SUFI_TARGET}" STREQUAL "")
        message(FATAL_ERROR "sufi_files: no current target. Call sufi_target before sufi_files.")
    endif()
    if(NOT TARGET ${SUFI_TARGET})
        message(FATAL_ERROR "sufi_files: target '${SUFI_TARGET}' does not exist.")
    endif()

    if(NOT DEFINED SUFI_DIR OR "${SUFI_DIR}" STREQUAL "." OR "${SUFI_DIR}" STREQUAL "")
        set(_sufi_prefix "")
    else()
        set(_sufi_prefix "${SUFI_DIR}/")
    endif()

    set(_sufi_paths)
    foreach(_sufi_file IN ITEMS ${ARGN})
        string(REGEX REPLACE ",$" "" _sufi_file "${_sufi_file}")
        string(STRIP "${_sufi_file}" _sufi_file)
        if("${_sufi_file}" STREQUAL "")
            continue()
        endif()
        list(APPEND _sufi_paths "${_sufi_prefix}${_sufi_file}")
    endforeach()

    if(_sufi_paths)
        target_sources(${SUFI_TARGET} PRIVATE ${_sufi_paths})
        # Xcode otherwise splits these into Header Files and Source Files.
        # Group by the real folders so both kinds sit together under the target.
        set(_sufi_grouped)
        foreach(_sufi_path IN LISTS _sufi_paths)
            list(APPEND _sufi_grouped "${CMAKE_CURRENT_SOURCE_DIR}/${_sufi_path}")
        endforeach()
        source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}" FILES ${_sufi_grouped})
        unset(_sufi_grouped)
    endif()

    unset(_sufi_prefix)
    unset(_sufi_paths)
    unset(_sufi_path)
    unset(_sufi_file)
endmacro()

# sufi_add_dependencies([SUFI_TRANSIENT|SUFI_NON_TRANSIENT,] dep1, dep2, ... depN)
# The leading word is optional and defaults to SUFI_NON_TRANSIENT.
# SUFI_TRANSIENT dependencies propagate to targets that link this one.
# Each dependency created with sufi_target also adds its own folder as an
# include directory, with the same visibility. Folders from sufi_dir are not added.
macro(sufi_add_dependencies)
    if(NOT DEFINED SUFI_TARGET OR "${SUFI_TARGET}" STREQUAL "")
        message(FATAL_ERROR "sufi_add_dependencies: no current target. Call sufi_target before sufi_add_dependencies.")
    endif()
    if(NOT TARGET ${SUFI_TARGET})
        message(FATAL_ERROR "sufi_add_dependencies: target '${SUFI_TARGET}' does not exist.")
    endif()
    if(${ARGC} LESS 1)
        message(FATAL_ERROR "sufi_add_dependencies: expected sufi_add_dependencies(dep1, dep2, ... depN)")
    endif()

    set(_sufi_deps)
    foreach(_sufi_dep IN ITEMS ${ARGN})
        string(REGEX REPLACE ",$" "" _sufi_dep "${_sufi_dep}")
        string(STRIP "${_sufi_dep}" _sufi_dep)
        if("${_sufi_dep}" STREQUAL "")
            continue()
        endif()
        list(APPEND _sufi_deps "${_sufi_dep}")
    endforeach()

    if(NOT _sufi_deps)
        message(FATAL_ERROR "sufi_add_dependencies: no dependencies given.")
    endif()

    list(GET _sufi_deps 0 _sufi_type)
    string(TOUPPER "${_sufi_type}" _sufi_type)
    string(REPLACE "-" "_" _sufi_type "${_sufi_type}")
    if(_sufi_type STREQUAL "SUFI_TRANSIENT")
        set(_sufi_scope PUBLIC)
        list(REMOVE_AT _sufi_deps 0)
    elseif(_sufi_type STREQUAL "SUFI_NON_TRANSIENT")
        set(_sufi_scope PRIVATE)
        list(REMOVE_AT _sufi_deps 0)
    else()
        set(_sufi_scope PRIVATE)
    endif()

    if(NOT _sufi_deps)
        message(FATAL_ERROR "sufi_add_dependencies: no dependencies given.")
    endif()

    target_link_libraries(${SUFI_TARGET} ${_sufi_scope} ${_sufi_deps})

    foreach(_sufi_dep IN LISTS _sufi_deps)
        if(NOT TARGET ${_sufi_dep})
            continue()
        endif()
        get_target_property(_sufi_dep_dir ${_sufi_dep} SUFI_TARGET_DIR)
        if(NOT _sufi_dep_dir)
            continue()
        endif()
        target_include_directories(${SUFI_TARGET} ${_sufi_scope} "${_sufi_dep_dir}")
    endforeach()

    unset(_sufi_type)
    unset(_sufi_scope)
    unset(_sufi_deps)
    unset(_sufi_dep)
    unset(_sufi_dep_dir)
endmacro()
